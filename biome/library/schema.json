{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library-object/1",
  "title": "Reusable object manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "source", "views", "shape", "reports", "scale", "collider", "lod", "asset", "art_director", "run", "collision", "camera_layer", "textures"],
  "properties": {
    "schema": { "const": "library-object/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "fixture": {
      "type": "boolean",
      "description": "True when the folder is a synthetic test object, not an Imagine cook."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imagineIds", "promptRef"],
      "properties": {
        "imagineIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Imagine job ids. Prompt prose is not stored here."
        },
        "promptRef": {
          "type": "string",
          "description": "Path to the prompt file kept with the cook. The text is not copied into this manifest."
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "files", "yawStepDeg"],
      "properties": {
        "dir": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
        "yawStepDeg": { "const": 45 }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "walkaround"],
      "properties": {
        "method": {
          "type": "string",
          "description": "Walkaround surface method name, such as surface-nets or legacy-voxels."
        },
        "walkaround": { "type": "string", "description": "Directory written by tools/walkaround/build.py." }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetcheck", "objsheet", "walkaround"],
      "properties": {
        "assetcheck": { "$ref": "#/$defs/report" },
        "objsheet": { "$ref": "#/$defs/report" },
        "walkaround": { "$ref": "#/$defs/report" }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "default"],
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "radius_m"],
      "properties": {
        "type": { "const": "circle" },
        "radius_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billboardViews", "impostor", "chain"],
      "properties": {
        "billboardViews": {
          "type": "array",
          "items": { "type": "string" },
          "description": "View file names used as far billboards. The library does not draw them."
        },
        "impostor": { "const": true },
        "chain": { "$ref": "#/$defs/lodChain" }
      }
    },
    "asset": { "type": "string", "description": "walkaround asset.json a layout spec places." },
    "art_director": {
      "const": "KEEP",
      "description": "Art Director KEEP recorded on the part. A visual note with no run PASS is not enough."
    },
    "art_director_report": {
      "type": "string",
      "description": "Gate report that carried the KEEP flag, when the intake pointed at a file."
    },
    "run": { "$ref": "#/$defs/run" },
    "collision": { "$ref": "#/$defs/collision" },
    "camera_layer": { "$ref": "#/$defs/cameraLayer" },
    "textures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/texture" }
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "verdict"],
      "properties": {
        "path": { "type": "string" },
        "verdict": { "enum": ["PASS", "WARN"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "verdict"],
      "properties": {
        "tool": { "enum": ["object-gate", "tools/gate", "gate"] },
        "verdict": { "const": "PASS" },
        "report": { "type": "string" }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boxes", "ground_anchor", "min_clearance_m"],
      "properties": {
        "boxes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "space"],
            "properties": {
              "min": { "$ref": "#/$defs/vec3" },
              "max": { "$ref": "#/$defs/vec3" },
              "space": { "const": "local" }
            }
          }
        },
        "ground_anchor": { "$ref": "#/$defs/vec3" },
        "min_clearance_m": { "type": "number", "minimum": 0 }
      }
    },
    "cameraLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["key", "approach"] }
      }
    },
    "lodChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lod0", "lod1", "lod2", "outlineDiffPx"],
      "properties": {
        "lod0": { "$ref": "#/$defs/lodLevel" },
        "lod1": { "$ref": "#/$defs/lodLevel" },
        "lod2": { "$ref": "#/$defs/lodLevel" },
        "outlineDiffPx": {
          "type": "object",
          "additionalProperties": false,
          "required": ["15", "40"],
          "properties": {
            "15": { "const": 0 },
            "40": { "const": 0 }
          }
        }
      }
    },
    "lodLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangles"],
      "properties": {
        "triangles": { "type": "integer", "minimum": 0 }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativePx", "mipmaps"],
      "properties": {
        "nativePx": { "type": "integer", "minimum": 1024 },
        "width": { "type": "integer", "minimum": 1024 },
        "height": { "type": "integer", "minimum": 1024 },
        "mipmaps": { "const": true }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    }
  }
}
