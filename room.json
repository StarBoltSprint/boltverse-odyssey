{
  "id": "citadel",
  "title": "Citadel",
  "pack": "u10",
  "packBump": "after every mp4/still replace — src is file?${PACK}",
  "open": "breath-spawn",
  "camera": "lock-off",
  "aspect": "9:16",
  "plate": "720x1280",
  "morph": false,
  "chrome": "none",
  "auth": false,
  "database": false,
  "stillsFirst": true,
  "playerVariable": "citadel style",
  "docs": ["CHAR.md", "COOK.md", "GROK.md", "ROOM.md", "ENTER.md", "ENGINE.md", "HANG.md"],
  "layout": {
    "hall": { "stills": "stills/", "films": "films/" },
    "a": { "stills": "stills/a/", "films": "films/a/" },
    "seuil": "stills/seuil/",
    "enter": "films/enter-hall-a.mp4",
    "note": "this GitHub repo is the recipe; stills/films here are empty"
  },
  "encode": {
    "vf": "scale=720:1280:force_original_aspect_ratio=increase,crop=720:1280",
    "vcodec": "libx264",
    "pix_fmt": "yuv420p",
    "audio": false,
    "movflags": "+faststart"
  },
  "lock": {
    "bolt": "lock/bolt-back.jpg",
    "char": "CHAR.md",
    "compose": {
      "spawn": "lock/example-spawn.jpg",
      "atA": "lock/example-at-a.jpg",
      "atB": "lock/example-at-b.jpg",
      "sealSpawn": "lock/SEAL-spawn.jpg",
      "sealA": "lock/SEAL-at-a.jpg",
      "sealB": "lock/SEAL-at-b.jpg"
    },
    "doors": {
      "A": { "id": "m1", "name": "teal", "side": "left" },
      "B": { "id": "m2", "name": "gold", "side": "right" }
    }
  },
  "doors": {
    "A": { "id": "m1", "name": "teal", "side": "left", "veil": "stills/seuil/teal-empty.jpg", "fill": "stills/seuil/teal-fill.jpg" },
    "B": { "id": "m2", "name": "gold", "side": "right", "veil": "stills/seuil/gold-empty.jpg", "fill": "stills/seuil/gold-fill.jpg" }
  },
  "poses": ["spawn", "atA", "atB"],
  "acts": ["breath", "walk", "enter"],
  "stills": {
    "spawn": "stills/spawn.jpg",
    "atA": "stills/at-a.jpg",
    "atB": "stills/at-b.jpg",
    "source": "first-frame of that pose's breath",
    "cook": "COOK.md — 3 stills in player style, Bolt locked, then films",
    "room2": "stills/a/ — do not overwrite hall",
    "seuil": {
      "tealFill": "stills/seuil/teal-fill.jpg",
      "tealEmpty": "stills/seuil/teal-empty.jpg",
      "goldFill": "stills/seuil/gold-fill.jpg",
      "goldEmpty": "stills/seuil/gold-empty.jpg"
    }
  },
  "clips": {
    "breath-spawn": {
      "file": "films/breath-spawn.mp4",
      "act": "breath",
      "loop": true,
      "duration": 6,
      "stillStart": "spawn",
      "stillEnd": "spawn",
      "poseStart": "spawn",
      "poseEnd": "spawn",
      "required": true
    },
    "breath-A": {
      "file": "films/breath-a.mp4",
      "act": "breath",
      "loop": true,
      "duration": 10,
      "stillStart": "atA",
      "stillEnd": "atA",
      "poseStart": "atA",
      "poseEnd": "atA",
      "required": true
    },
    "breath-B": {
      "file": "films/breath-b.mp4",
      "act": "breath",
      "loop": true,
      "duration": 10,
      "stillStart": "atB",
      "stillEnd": "atB",
      "poseStart": "atB",
      "poseEnd": "atB",
      "required": true
    },
    "walk-spawn-A": {
      "file": "films/walk-spawn-a.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "spawn",
      "stillEnd": "atA",
      "poseStart": "spawn",
      "poseEnd": "atA",
      "required": true
    },
    "walk-spawn-B": {
      "file": "films/walk-spawn-b.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "spawn",
      "stillEnd": "atB",
      "poseStart": "spawn",
      "poseEnd": "atB",
      "required": true
    },
    "walk-A-B": {
      "file": "films/walk-a-b.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "atA",
      "stillEnd": "atB",
      "poseStart": "atA",
      "poseEnd": "atB",
      "required": false
    },
    "walk-B-A": {
      "file": "films/walk-b-a.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "atB",
      "stillEnd": "atA",
      "poseStart": "atB",
      "poseEnd": "atA",
      "required": false
    }
  },
  "enter": {
    "outsideThe7": true,
    "map": "ENTER[room][door]",
    "firstAndLastDistinct": true,
    "neverLastHallPrime": true,
    "onEnded": "switch room first, then dest breath-spawn",
    "clips": {
      "enter-hall-a": {
        "file": "films/enter-hall-a.mp4",
        "act": "enter",
        "loop": false,
        "duration": 6,
        "stillStart": "atA",
        "stillEnd": "teal-fill",
        "poseStart": "atA",
        "poseEnd": "spawn",
        "to": "a",
        "veil": "stills/seuil/teal-empty.jpg",
        "required": false,
        "cook": "ENTER.md + HANG.md — two plates, first+last distinct"
      }
    }
  },
  "edges": [
    { "from": "spawn", "tap": "A", "clip": "walk-spawn-A", "arrive": "breath-A" },
    { "from": "spawn", "tap": "B", "clip": "walk-spawn-B", "arrive": "breath-B" },
    { "from": "atA", "tap": "B", "clip": "walk-A-B", "arrive": "breath-B" },
    { "from": "atB", "tap": "A", "clip": "walk-B-A", "arrive": "breath-A" },
    { "from": "atA", "tap": "A", "clip": null, "arrive": "breath-A", "act": "stay", "or": "enter if link" },
    { "from": "atB", "tap": "B", "clip": null, "arrive": "breath-B", "act": "stay", "or": "enter if link" }
  ],
  "links": [
    {
      "from": { "room": "hall", "pose": "atA", "door": "A" },
      "to": { "room": "a", "pose": "spawn" },
      "clip": "enter-hall-a",
      "curtain": "teal-empty 500ms"
    }
  ],
  "join": {
    "cutIf": "stillEnd(from) == stillStart(to)",
    "else": "dissolve<=280ms",
    "enter": "hide enter 0ms + empty veil of THAT door 500ms (double rAF) → dest breath-spawn",
    "walkEnded": "breath(arrive) at t=0 — never auto-enter",
    "enterEnded": "switch room FIRST → breath-spawn dest",
    "never": [
      "walk->walk",
      "black-hole",
      "morph",
      "play-once-then-freeze breath",
      "paint-paused-video",
      "unmute-before-play",
      "missing-playsInline",
      "text-to-image-new-bolt",
      "3d-dungeon",
      "first-atA-and-last-Hall-prime-in-one-clip",
      "enter-as-image-to-video-one-still",
      "crossfade-two-dogs-different-slots",
      "auto-enter-on-walk-ended",
      "enter-from-spawn",
      "gold-enter-with-teal-veil",
      "overwrite-hall-stills-with-room2",
      "skip-PACK-bump"
    ]
  },
  "hits": {
    "layout": "video-contain-9:16",
    "on": "picture-not-letterbox",
    "A": { "x": 0, "w": 0.4 },
    "center": { "x": 0.4, "w": 0.2 },
    "B": { "x": 0.6, "w": 0.4 }
  },
  "player": {
    "stillUnderlayer": true,
    "stillHiddenDuringEnter": true,
    "dualVideo": true,
    "hideUntilPlaying": true,
    "playMuted": true,
    "playsInline": true,
    "paintOnlyIfPlaying": true,
    "setWalkingOnlyAfterPlay": true,
    "pauseOutgoing": true,
    "ignoreTapsWhileWalking": true,
    "sameDoorAtSpawn": "walk",
    "sameDoorAtDoor": "enter-if-link-else-stay",
    "openIsTheRoom": true,
    "domOnly": "img+2video+veil",
    "curtainMs": 500,
    "curtainStillByDoor": {
      "A": "stills/seuil/teal-empty.jpg",
      "B": "stills/seuil/gold-empty.jpg"
    },
    "doubleRafVeil": true
  },
  "cook": {
    "stillsFirst": true,
    "plate": "720x1280",
    "cropNon916": true,
    "firstAndLastDistinct": "walks + enter. Breath is the only first=last loop.",
    "spawn": "sealed: copy lock/SEAL-spawn.jpg (skip imagineStill). else imagineStill pose=spawn via cook-room (bolt-back + example-spawn + catalog lines)",
    "atA": "imagineStill pose=atA from spawn via cook-room — never chat Imagine",
    "atB": "imagineStill pose=atB from spawn via cook-room — never chat Imagine",
    "breath": "imagineClip first=last=pose still; seamless loop; feet glued; freeze still if dest breath walks",
    "walk": "imagineClip image+last_frame start→arrive; no chat reference_to_video; no loop; back-to-camera; no 3/4",
    "enter": "HANG.md + ENTER.md — two plates; first=atA last=same-slot fill; never last=Hall-prime; 6s; one dog; engine veil 500ms of THAT door",
    "still": "first frame of that pose's breath — last-frame grab can be empty"
  }
}
