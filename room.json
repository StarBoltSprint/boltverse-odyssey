{
  "id": "citadel",
  "title": "Citadel",
  "pack": "u10",
  "open": "breath-spawn",
  "camera": "lock-off",
  "aspect": "9:16",
  "plate": "720x1280",
  "morph": false,
  "chrome": "none",
  "auth": false,
  "database": false,
  "stillsFirst": true,
  "playerVariable": "citadel style",
  "lock": {
    "bolt": "lock/bolt-back.jpg",
    "char": "CHAR.md",
    "compose": {
      "spawn": "lock/example-spawn.jpg",
      "atA": "lock/example-at-a.jpg",
      "atB": "lock/example-at-b.jpg"
    },
    "doors": {
      "A": { "id": "m1", "name": "teal", "side": "left" },
      "B": { "id": "m2", "name": "gold", "side": "right" }
    }
  },
  "doors": {
    "A": { "id": "m1", "name": "teal", "side": "left" },
    "B": { "id": "m2", "name": "gold", "side": "right" }
  },
  "poses": ["spawn", "atA", "atB"],
  "acts": ["breath", "walk", "enter"],
  "stills": {
    "spawn": "stills/spawn.jpg",
    "atA": "stills/at-a.jpg",
    "atB": "stills/at-b.jpg",
    "source": "first-frame of that pose's breath",
    "cook": "COOK.md — 3 stills in player style, Bolt locked, then films",
    "seuil": {
      "tealFill": "stills/seuil/teal-fill.jpg",
      "tealEmpty": "stills/seuil/teal-empty.jpg"
    }
  },
  "clips": {
    "breath-spawn": {
      "file": "films/breath-spawn.mp4",
      "act": "breath",
      "loop": true,
      "duration": 6,
      "stillStart": "spawn",
      "stillEnd": "spawn",
      "poseStart": "spawn",
      "poseEnd": "spawn",
      "required": true
    },
    "breath-A": {
      "file": "films/breath-a.mp4",
      "act": "breath",
      "loop": true,
      "duration": 10,
      "stillStart": "atA",
      "stillEnd": "atA",
      "poseStart": "atA",
      "poseEnd": "atA",
      "required": true
    },
    "breath-B": {
      "file": "films/breath-b.mp4",
      "act": "breath",
      "loop": true,
      "duration": 10,
      "stillStart": "atB",
      "stillEnd": "atB",
      "poseStart": "atB",
      "poseEnd": "atB",
      "required": true
    },
    "walk-spawn-A": {
      "file": "films/walk-spawn-a.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "spawn",
      "stillEnd": "atA",
      "poseStart": "spawn",
      "poseEnd": "atA",
      "required": true
    },
    "walk-spawn-B": {
      "file": "films/walk-spawn-b.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "spawn",
      "stillEnd": "atB",
      "poseStart": "spawn",
      "poseEnd": "atB",
      "required": true
    },
    "walk-A-B": {
      "file": "films/walk-a-b.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "atA",
      "stillEnd": "atB",
      "poseStart": "atA",
      "poseEnd": "atB",
      "required": false
    },
    "walk-B-A": {
      "file": "films/walk-b-a.mp4",
      "act": "walk",
      "loop": false,
      "duration": 10,
      "stillStart": "atB",
      "stillEnd": "atA",
      "poseStart": "atB",
      "poseEnd": "atA",
      "required": false
    },
    "enter-hall-a": {
      "file": "films/enter-hall-a.mp4",
      "act": "enter",
      "loop": false,
      "duration": 6,
      "stillStart": "atA",
      "stillEnd": "teal-fill",
      "poseStart": "atA",
      "poseEnd": "spawn",
      "to": "a",
      "required": false,
      "cook": "ENTER.md — two plates, never first=atA and last=Hall-prime in one clip"
    }
  },
  "edges": [
    { "from": "spawn", "tap": "A", "clip": "walk-spawn-A", "arrive": "breath-A" },
    { "from": "spawn", "tap": "B", "clip": "walk-spawn-B", "arrive": "breath-B" },
    { "from": "atA", "tap": "B", "clip": "walk-A-B", "arrive": "breath-B" },
    { "from": "atB", "tap": "A", "clip": "walk-B-A", "arrive": "breath-A" },
    { "from": "atA", "tap": "A", "clip": null, "arrive": "breath-A", "act": "stay", "or": "enter if link" },
    { "from": "atB", "tap": "B", "clip": null, "arrive": "breath-B", "act": "stay", "or": "enter if link" }
  ],
  "links": [
    {
      "from": { "room": "hall", "pose": "atA", "door": "A" },
      "to": { "room": "a", "pose": "spawn" },
      "clip": "enter-hall-a",
      "curtain": "teal-empty 500ms"
    }
  ],
  "join": {
    "cutIf": "stillEnd(from) == stillStart(to)",
    "else": "dissolve<=280ms",
    "enter": "hide enter 0ms + empty-teal veil 500ms → dest breath-spawn",
    "walkEnded": "breath(arrive) at t=0 — never auto-enter",
    "enterEnded": "switch room → breath-spawn dest",
    "never": [
      "walk->walk",
      "black-hole",
      "morph",
      "play-once-then-freeze breath",
      "paint-paused-video",
      "unmute-before-play",
      "text-to-image-new-bolt",
      "3d-dungeon",
      "first-atA-and-last-Hall-prime-in-one-clip",
      "crossfade-two-dogs-different-slots",
      "auto-enter-on-walk-ended",
      "enter-from-spawn"
    ]
  },
  "hits": {
    "layout": "video-contain-9:16",
    "on": "picture-not-letterbox",
    "A": { "x": 0, "w": 0.4 },
    "center": { "x": 0.4, "w": 0.2 },
    "B": { "x": 0.6, "w": 0.4 }
  },
  "player": {
    "stillUnderlayer": true,
    "stillHiddenDuringEnter": true,
    "dualVideo": true,
    "hideUntilPlaying": true,
    "playMuted": true,
    "paintOnlyIfPlaying": true,
    "setWalkingOnlyAfterPlay": true,
    "pauseOutgoing": true,
    "ignoreTapsWhileWalking": true,
    "sameDoorAtSpawn": "walk",
    "sameDoorAtDoor": "enter-if-link-else-stay",
    "openIsTheRoom": true,
    "domOnly": "img+2video+veil",
    "curtainMs": 500,
    "curtainStill": "stills/seuil/teal-empty.jpg"
  },
  "cook": {
    "stillsFirst": true,
    "plate": "720x1280",
    "cropNon916": true,
    "spawn": "reference_to_image(bolt-back, example-spawn) + player style",
    "atA": "image_to_image(spawn) Bolt to teal",
    "atB": "image_to_image(spawn) Bolt to gold",
    "breath": "first=last=pose still; seamless loop; feet glued",
    "walk": "first=start still; last=arrive still; interpolate; no loop; back-to-camera whole clip; no 3/4",
    "enter": "ENTER.md — two plates; first=atA last=same-slot teal-full; never last=Hall-prime; 6s; one dog; engine veil 500ms",
    "still": "first frame of that pose's breath — last-frame grab can be empty"
  }
}
