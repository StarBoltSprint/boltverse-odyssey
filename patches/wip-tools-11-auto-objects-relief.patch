+def frame(eye, base, top, margin_deg=6.0):
+    """Target + vertical fov so the whole object (base..top) stands in frame, ground and sky visible."""
+    eye = np.asarray(eye, np.float64); hd = math.hypot(base[0] - eye[0], base[2] - eye[2])
+    a_top = math.atan2(top - eye[1], hd); a_bot = math.atan2(base[1] - 0.6 - eye[1], hd)
+    mid = (a_top + a_bot) / 2; fov = math.degrees(a_top - a_bot) + 2 * margin_deg
+    tgt = np.array([base[0], eye[1] + hd * math.tan(mid), base[2]])
+    return tgt, max(40.0, min(100.0, fov))
+
+
+def flat_frac(C, I, mid=1):
+    """World-render untextured check: share of object pixels whose 5x5 luminance spread is ~0 (flat paint / grey fill;
+    stone, snow and runes from the plate always carry texture)."""
+    from scipy import ndimage as ndi
+    L = C.mean(2); m = I == mid
+    if m.sum() < 50: return 0.0
