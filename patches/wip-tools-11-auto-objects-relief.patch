+def seamless_ground(g):
+    """Ground plate -> tileable, crack-free texture: thin dark crack lines (much darker than their 9 px neighbourhood) are
+    closed away; the plate is used as-is (seamless by recipe), with a border cross-fade only if its wrap seam shows."""
+    from scipy import ndimage as ndi
+    g = np.asarray(g, np.float32); L = g.mean(2); Lc = ndi.grey_closing(L, size=(15, 15))
+    crack = ndi.binary_dilation((Lc - L) > 10, iterations=1)
+    if crack.any() and (~crack).any():
+        idx = ndi.distance_transform_edt(crack, return_distances=False, return_indices=True); g = g[idx[0], idx[1]]
+        g = ndi.gaussian_filter(g, (1, 1, 0))
+    # seam check: the ground plates are generated seamless; if the wrap seam is visible, cross-fade a 6 % border band
+    e = max(4, g.shape[0] // 16)
+    if np.abs(g[:, :2].mean() - g[:, -2:].mean()) + np.abs(g[:2].mean() - g[-2:].mean()) > 6:
+        r = np.linspace(0, 1, e, dtype=np.float32)[None, :, None]; g[:, :e] = g[:, :e] * r + g[:, -e:][:, ::-1] * (1 - r)
+        r = r.transpose(1, 0, 2); g[:e] = g[:e] * r + g[-e:][::-1] * (1 - r)
+    seamless_ground.crackFrac = round(float(crack.mean()), 4)
+    return g.clip(0, 255).astype(np.uint8)
+
