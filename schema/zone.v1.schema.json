{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltverse.odyssey/zone.v1.schema.json",
  "title": "zone.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "id",
    "keyImage",
    "keyCamera",
    "biome",
    "lighting",
    "objects",
    "gameplay",
    "qualityGates",
    "todo",
    "wakeDefaults",
    "runtime"
  ],
  "properties": {
    "schema": { "const": "zone.v1" },
    "version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "keyImage": { "type": "string", "minLength": 1 },
    "keyCamera": { "$ref": "#/$defs/camera" },
    "biome": { "type": "object" },
    "lighting": {
      "type": "object",
      "required": ["sun", "fog", "halo"],
      "properties": {
        "sun": { "type": "object" },
        "fog": { "type": "object" },
        "halo": { "type": "object" }
      }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object" }
    },
    "gameplay": { "type": "object" },
    "qualityGates": { "type": "object" },
    "todo": { "type": "array", "items": { "type": "string" } },
    "wakeDefaults": { "$ref": "#/$defs/wake" },
    "runtime": { "type": "object" }
  },
  "$defs": {
    "wake": {
      "type": "object",
      "required": ["type", "enabled"],
      "properties": {
        "type": { "const": "placeholder" },
        "enabled": { "const": false }
      }
    },
    "asset": {
      "type": "object",
      "required": ["glb", "lods"],
      "properties": {
        "glb": { "type": ["string", "null"] },
        "lods": { "type": "array", "items": { "type": "string" } }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "asset", "sources", "cameras", "transform", "fidelity", "wake"],
      "properties": {
        "id": { "type": "string" },
        "asset": { "$ref": "#/$defs/asset" },
        "sources": { "type": "array" },
        "cameras": { "type": "array" },
        "transform": {
          "type": "object",
          "required": ["position", "rotationDeg", "scale"],
          "properties": {
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": ["number", "null"] }
            },
            "rotationDeg": {},
            "scale": {}
          }
        },
        "fidelity": { "type": "object" },
        "wake": { "$ref": "#/$defs/wake" }
      }
    },
    "camera": {
      "type": "object",
      "required": ["fov"],
      "properties": {
        "position": { "type": ["array", "null"] },
        "target": { "type": ["array", "null"] },
        "fov": { "type": "number" },
        "previewPose": { "type": "object" }
      }
    }
  }
}
