{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/StarBoltSprint/boltverse-odyssey/tools/biome/schema/biome.schema.json",
 "title": "biome/1 - Boltverse Odyssey biome bible",
 "description": "One file decided BEFORE any asset exists. Every Imagine prompt, QC target, Blender bake and three.js setting is derived from it. Values written as \"$local\" live in the untracked <id>.local.json (palette hex, style block, avoid list, subject/tone words - repo rule 2026-10-03).",
 "type": "object",
 "required": ["schema", "id", "bibleVersion", "seed", "anchor", "sun", "palette", "fog", "exposure", "lut", "sky", "planet", "ground", "objects", "camera", "post", "budgets", "qc", "styleId", "styleBlock", "avoid"],
 "additionalProperties": false,
 "definitions": {
  "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
  "rgb3": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 4}, "minItems": 3, "maxItems": 3},
  "words": {"type": "string", "minLength": 1},
  "range2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
 },
 "properties": {
  "schema": {"const": "biome/1"},
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
  "name": {"type": "string"},
  "archetype": {"type": "string", "enum": ["mesa-desert", "ice-tundra", "volcanic", "verdant", "crystal", "void-nebula"]},
  "bibleVersion": {"type": "integer", "minimum": 1, "description": "Bump on any change that should regenerate cached Imagine slots (part of every cache key)."},
  "seed": {"type": "integer", "minimum": 0},
  "lore": {"type": "object", "properties": {"row": {"type": "string"}, "playerLine": {"type": "string"}}},
  "anchor": {
   "type": "object", "required": ["slot", "aspect"],
   "description": "The key still: generated FIRST, every other asset is QC'd against it.",
   "properties": {
    "slot": {"const": "key"},
    "aspect": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "subject": {"$ref": "#/definitions/words"},
    "file": {"type": "string"},
    "horizonRow": {"type": "number", "minimum": 0, "maximum": 1, "description": "Horizon line as a fraction of image height (0 = top). Used to cut sky/ground regions."},
    "sampled": {"type": "object", "description": "Written by qc.py anchor: Lab of horizon, shadow, highlight, sky, ground + mean saturation."}
   }
  },
  "sun": {
   "type": "object", "required": ["azimuthDeg", "elevationDeg", "kelvin", "hex", "side"],
   "properties": {
    "azimuthDeg": {"type": "number", "minimum": 0, "maximum": 360, "description": "World heading of the sun disc; sky plate H0 is centred on it."},
    "elevationDeg": {"type": "number", "minimum": -5, "maximum": 90},
    "kelvin": {"type": "number", "minimum": 1500, "maximum": 12000},
    "hex": {"$ref": "#/definitions/hex"},
    "side": {"type": "string", "enum": ["left", "right", "back", "front"], "description": "Where the key light hits from, seen along the run direction."},
    "intensity": {"type": "number", "minimum": 0, "maximum": 4}
   }
  },
  "palette": {
   "type": "object", "required": ["key", "fill", "shadow", "horizon", "zenith", "ground"],
   "properties": {
    "key": {"$ref": "#/definitions/hex"}, "fill": {"$ref": "#/definitions/hex"}, "shadow": {"$ref": "#/definitions/hex"},
    "horizon": {"$ref": "#/definitions/hex"}, "zenith": {"$ref": "#/definitions/hex"}, "ground": {"$ref": "#/definitions/hex"},
    "accent": {"$ref": "#/definitions/hex"}, "rim": {"$ref": "#/definitions/hex"},
    "horizonSampled": {"$ref": "#/definitions/hex"}
   }
  },
  "fog": {
   "type": "object", "required": ["color", "near", "far", "desat", "bands"],
   "properties": {
    "color": {"$ref": "#/definitions/hex"},
    "near": {"type": "number", "minimum": 0}, "far": {"type": "number", "minimum": 1},
    "desat": {"type": "number", "minimum": 0, "maximum": 1},
    "heightFalloff": {"type": "number", "minimum": 0},
    "bands": {
     "type": "array", "minItems": 3, "maxItems": 3, "description": "Warm near -> cool far. dist = metres where the band is fully reached.",
     "items": {"type": "object", "required": ["dist", "color", "amount"], "properties": {
      "dist": {"type": "number", "minimum": 0}, "color": {"$ref": "#/definitions/hex"}, "amount": {"type": "number", "minimum": 0, "maximum": 1}}}
    }
   }
  },
  "exposure": {"type": "object", "required": ["ev", "whiteBalanceK"], "properties": {
   "ev": {"type": "number", "minimum": -4, "maximum": 4}, "whiteBalanceK": {"type": "number", "minimum": 2000, "maximum": 12000}}},
  "lut": {"type": "object", "required": ["lift", "gamma", "gain", "saturation"], "properties": {
   "lift": {"$ref": "#/definitions/rgb3"}, "gamma": {"$ref": "#/definitions/rgb3"}, "gain": {"$ref": "#/definitions/rgb3"},
   "saturation": {"type": "number", "minimum": 0, "maximum": 2}, "contrast": {"type": "number", "minimum": 0.5, "maximum": 1.5}}},
  "sky": {
   "type": "object", "required": ["horizonPlates", "plateHFovDeg", "zenith", "nadir", "outSize", "planetInSky"],
   "properties": {
    "subject": {"$ref": "#/definitions/words"},
    "horizonPlates": {"type": "integer", "minimum": 3, "maximum": 16},
    "plateHFovDeg": {"type": "number", "minimum": 20, "maximum": 120},
    "plateAspect": {"type": "string"},
    "zenith": {"type": "boolean"}, "nadir": {"type": "boolean"},
    "capFovDeg": {"type": "number", "minimum": 30, "maximum": 160},
    "outSize": {"$ref": "#/definitions/range2"},
    "bandSize": {"$ref": "#/definitions/range2"},
    "planetInSky": {"const": false}
   }
  },
  "planet": {"type": "object", "required": ["radius", "distance", "azimuthDeg", "elevationDeg", "spinDegPerSec"], "properties": {
   "subject": {"$ref": "#/definitions/words"},
   "radius": {"type": "number", "minimum": 1}, "distance": {"type": "number", "minimum": 10},
   "azimuthDeg": {"type": "number"}, "elevationDeg": {"type": "number"}, "spinDegPerSec": {"type": "number"},
   "ring": {"type": "object", "properties": {"inner": {"type": "number"}, "outer": {"type": "number"}, "tiltDeg": {"type": "number"}, "spinDegPerSec": {"type": "number"}}}}},
  "ground": {"type": "object", "required": ["tiles", "tileMeters", "materials"], "properties": {
   "tiles": {"type": "integer", "minimum": 1, "maximum": 16},
   "tileMeters": {"type": "number", "minimum": 0.5},
   "heightFromAlbedo": {"type": "boolean"},
   "heightMeters": {"type": "number"},
   "bombing": {"type": "object"},
   "macroScale": {"type": "number"},
   "bigRocks": {"type": "integer", "minimum": 0},
   "materials": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "subject"], "properties": {
    "id": {"type": "string"}, "subject": {"$ref": "#/definitions/words"}, "weight": {"type": "number"}}}}}},
  "objects": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "subject", "heightM", "views", "lods", "tex"], "properties": {
   "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
   "kind": {"type": "string", "enum": ["hero", "mesa", "rock", "wreck", "prop", "bird"]},
   "subject": {"$ref": "#/definitions/words"},
   "count": {"type": "integer", "minimum": 0},
   "heightM": {"type": "number", "minimum": 0.05},
   "layer": {"type": "string", "enum": ["near", "mid", "far", "landmark"]},
   "views": {"type": "object", "required": ["ortho"], "properties": {
    "ortho": {"type": "array", "items": {"type": "string", "enum": ["front", "right", "back", "left", "top"]}},
    "threeQuarter": {"type": "array", "items": {"type": "number", "enum": [45, 135, 225, 315]}}}},
   "lods": {"type": "array", "items": {"type": "integer", "minimum": 8}, "minItems": 1, "maxItems": 4},
   "tex": {"type": "integer", "enum": [256, 512, 1024, 2048, 4096]},
   "displaceM": {"type": "number", "minimum": 0}}}},
  "ambient": {"type": "array", "items": {"type": "string"}},
  "camera": {"type": "object", "required": ["fovBase", "fovSprint"], "properties": {
   "fovBase": {"type": "number", "minimum": 30, "maximum": 100}, "fovSprint": {"type": "number", "minimum": 30, "maximum": 110},
   "fovDamp": {"type": "number"}, "near": {"type": "number"}, "far": {"type": "number"},
   "pixelRatioCap": {"type": "number", "minimum": 0.5, "maximum": 3},
   "trauma": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "landing": {"type": "number"}, "decayPerSec": {"type": "number"}, "rollRad": {"type": "number"}, "liftM": {"type": "number"}}}}},
  "post": {"type": "object", "required": ["toneMapping", "grain", "vignette"], "properties": {
   "toneMapping": {"const": "none"},
   "runtimeLut": {"type": "boolean", "description": "false = plates and bakes are graded offline (qc.py), runtime applies no second grade"},
   "contrast": {"type": "number", "minimum": 0.8, "maximum": 1.3}, "gamma": {"type": "number", "minimum": 0.7, "maximum": 1.3},
   "grain": {"type": "number", "minimum": 0, "maximum": 0.2},
   "vignette": {"type": "object", "properties": {"start": {"type": "number"}, "end": {"type": "number"}, "strength": {"type": "number", "minimum": 0, "maximum": 1}}},
   "sceneFog": {"const": false, "description": "three.js scene.fog stays null; the biome fog chunk does the work."},
   "bloom": {"type": "object"}}},
  "budgets": {"type": "object", "required": ["imagineImages"], "properties": {
   "imagineImages": {"type": "integer", "minimum": 1, "maximum": 80},
   "drawCalls": {"type": "integer"}, "trisOnScreen": {"type": "integer"}, "texMB": {"type": "number"}, "attemptsPerSlot": {"type": "integer", "minimum": 1, "maximum": 3}}},
  "qc": {"type": "object", "properties": {
   "deltaE": {"type": "string", "enum": ["2000", "76"]},
   "horizonDE": {"type": "number"}, "shadowDE": {"type": "number"}, "shadowLMin": {"type": "number"},
   "highlightDE": {"type": "number"}, "satTol": {"type": "number"}, "objectLitDE": {"type": "number"},
   "seamDE": {"type": "number"}, "bboxMin": {"type": "number"}, "grainLapVarMin": {"type": "number"},
   "lutMaxFactor": {"type": "number"}, "maxFails": {"type": "integer"}}},
  "styleId": {"type": "string"},
  "styleBlock": {"$ref": "#/definitions/words"},
  "tone": {"type": "object"},
  "avoid": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "catalogueFallback": {"type": "string", "description": "Archetype pack used when a slot fails QC twice."}
 }
}
